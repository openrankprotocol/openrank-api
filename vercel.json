{
  "version": 2,
  "rewrites": [
    {
      "source": "/summaries",
      "destination": "/api/summaries"
    },
    {
      "source": "/discord",
      "destination": "/api/discord"
    },
    {
      "source": "/github",
      "destination": "/api/github"
    },
    {
      "source": "/telegram",
      "destination": "/api/telegram"
    },
    {
      "source": "/telegram/users",
      "destination": "/api/telegram/users"
    },
    {
      "source": "/x",
      "destination": "/api/x"
    },
    {
      "source": "/telegram/pfps/:id",
      "destination": "/api/telegram/pfps/[id]?id=:id"
    },
    {
      "source": "/discord/:serverId",
      "destination": "/api/discord/[serverId]/index?serverId=:serverId"
    },
    {
      "source": "/discord/:serverId/seed",
      "destination": "/api/discord/[serverId]/seed?serverId=:serverId"
    },
    {
      "source": "/discord/:serverId/scores",
      "destination": "/api/discord/[serverId]/scores?serverId=:serverId"
    },
    {
      "source": "/github/(.*)",
      "destination": "/api/github/[...params]?params=$1"
    },
    {
      "source": "/telegram/:channelId",
      "destination": "/api/telegram/[channelId]/index?channelId=:channelId"
    },
    {
      "source": "/telegram/:channelId/seed",
      "destination": "/api/telegram/[channelId]/seed?channelId=:channelId"
    },
    {
      "source": "/telegram/:channelId/scores",
      "destination": "/api/telegram/[channelId]/scores?channelId=:channelId"
    },
    {
      "source": "/communities",
      "destination": "/api/communities"
    },
    {
      "source": "/communities/(.*)",
      "destination": "/api/communities/[communityId]/index?communityId=$1"
    },
    {
      "source": "/x/:communityId",
      "destination": "/api/x/[communityId]/index?communityId=:communityId"
    },
    {
      "source": "/x/:communityId/seed",
      "destination": "/api/x/[communityId]/seed?communityId=:communityId"
    },
    {
      "source": "/x/:communityId/scores",
      "destination": "/api/x/[communityId]/scores?communityId=:communityId"
    }
  ],
  "devCommand": "node server.js"
}
